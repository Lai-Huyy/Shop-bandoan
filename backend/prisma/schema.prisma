generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum ProductStatus {
  DRAFT
  AVAILABLE
  OUT_OF_STOCK
  ARCHIVED
}

enum DiscountType {
  FIXED_AMOUNT
  PERCENTAGE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  STRIPE
  PAYPAL
  VNPAY
  MOMO
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum NotificationType {
  SYSTEM
  ORDER_STATUS
  PROMOTION
}

// ============================================================================
// SECURITY & USER MANAGEMENT
// ============================================================================

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(50)
  description String? @db.Text
  users       User[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  username     String     @unique @db.VarChar(50)
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  fullName     String     @map("full_name") @db.VarChar(100)
  phone        String?    @db.VarChar(20)
  avatarUrl    String?    @map("avatar_url") @db.Text
  status       UserStatus @default(ACTIVE)

  roleId Int  @map("role_id")
  role   Role @relation(fields: [roleId], references: [id])

  addresses     UserAddress[]
  sessions      UserSession[]
  cart          Cart?
  orders        Order[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  couponClaims  CouponClaim[]
  notifications Notification[]
  auditLogs     AuditLog[]
  statusLogs    OrderStatusLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([status])
  @@map("users")
}

model UserAddress {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label          String?  @db.VarChar(50)
  note           String?  @db.VarChar(500)
  provinceCode   String?  @map("province_code") @db.VarChar(10)
  provinceName   String?  @map("province_name") @db.VarChar(100)
  wardCode       String?  @map("ward_code") @db.VarChar(10)
  wardName       String?  @map("ward_name") @db.VarChar(100)
  recipientName  String   @map("recipient_name") @db.VarChar(100)
  recipientPhone String   @map("recipient_phone") @db.VarChar(20)
  streetAddress  String   @map("street_address") @db.Text
  ward           String?  @db.VarChar(100)
  district       String?  @db.VarChar(100)
  city           String   @db.VarChar(100)
  latitude       Decimal? @db.Decimal(10, 8)
  longitude      Decimal? @db.Decimal(11, 8)
  isDefault      Boolean  @default(false) @map("is_default")

  orders Order[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("user_addresses")
}

model UserSession {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String   @map("refresh_token_hash") @db.VarChar(255)
  deviceIdentifier String?  @map("device_identifier") @db.VarChar(255)
  ipAddress        String?  @map("ip_address") @db.VarChar(45)
  isRevoked        Boolean  @default(false) @map("is_revoked")
  expiresAt        DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([refreshTokenHash])
  @@map("user_sessions")
}

// ============================================================================
// RESTAURANTS
// ============================================================================

model Restaurant {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(150)
  slug        String    @unique @db.VarChar(180)
  description String?   @db.Text
  address     String    @db.Text
  phone       String?   @db.VarChar(20)
  imageUrl    String?   @map("image_url") @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([deletedAt, createdAt])
  @@map("restaurants")
}

// ============================================================================
// CATALOG (CATEGORIES & PRODUCTS)
// ============================================================================

model Category {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(100)
  slug        String  @unique @db.VarChar(120)
  description String? @db.Text
  imageUrl    String? @map("image_url") @db.Text
  isDisplayed Boolean @default(true) @map("is_displayed")
  sortOrder   Int     @default(0) @map("sort_order")

  parentId Int?       @map("parent_id")
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  products Product[]
  coupons  Coupon[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([slug])
  @@map("categories")
}

model Product {
  id            String        @id @default(uuid()) @db.Uuid
  name          String        @db.VarChar(200)
  slug          String        @unique @db.VarChar(220)
  description   String?       @db.Text
  basePrice     Decimal       @map("base_price") @db.Decimal(12, 2)
  status        ProductStatus @default(AVAILABLE)
  stockQuantity Int           @default(0) @map("stock_quantity")
  soldQuantity  Int           @default(0) @map("sold_quantity")

  categoryId Int      @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id])

  images        ProductImage[]
  options       ProductOption[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  reviews       Review[]
  wishlistItems WishlistItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([slug])
  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url       String  @db.Text
  altText   String? @map("alt_text") @db.VarChar(255)
  isPrimary Boolean @default(false) @map("is_primary")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@map("product_images")
}

model ProductOption {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name       String  @db.VarChar(100)
  values     Json    @db.JsonB
  isRequired Boolean @default(false) @map("is_required")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@map("product_options")
}

// ============================================================================
// CART & SHOPPING
// ============================================================================

model Cart {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  couponId String? @map("coupon_id") @db.Uuid
  coupon   Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  items CartItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("carts")
}

model CartItem {
  id     String @id @default(uuid()) @db.Uuid
  cartId String @map("cart_id") @db.Uuid
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  selectedOptions Json?   @map("selected_options") @db.JsonB
  quantity        Int     @default(1)
  unitPrice       Decimal @map("unit_price") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([cartId])
  @@map("cart_items")
}

// ============================================================================
// COUPONS & DISCOUNTS
// ============================================================================

model Coupon {
  id                 String       @id @default(uuid()) @db.Uuid
  code               String       @unique @db.VarChar(50)
  description        String?      @db.Text
  discountType       DiscountType @map("discount_type")
  discountValue      Decimal      @map("discount_value") @db.Decimal(12, 2)
  minOrderSubtotal   Decimal      @default(0) @map("min_order_subtotal") @db.Decimal(12, 2)
  maxDiscountAmount  Decimal?     @map("max_discount_amount") @db.Decimal(12, 2)
  maxRedemptions     Int?         @map("max_redemptions")
  currentRedemptions Int          @default(0) @map("current_redemptions")
  startDate          DateTime     @map("start_date")
  endDate            DateTime     @map("end_date")
  isActive           Boolean      @default(true) @map("is_active")

  categoryId Int?      @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  carts  Cart[]
  orders Order[]
  claims CouponClaim[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([code])
  @@map("coupons")
}

/// A customer's one-time ownership record for a coupon. The composite unique
/// constraint is the database authority that prevents a coupon from being
/// claimed more than once by the same user.
model CouponClaim {
  id String @id @default(uuid()) @db.Uuid

  couponId String @map("coupon_id") @db.Uuid
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderId String? @unique @map("order_id") @db.Uuid
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  claimedAt DateTime  @default(now()) @map("claimed_at")
  usedAt    DateTime? @map("used_at")

  @@unique([couponId, userId])
  @@index([userId, usedAt, claimedAt])
  @@index([couponId, usedAt])
  @@map("coupon_claims")
}

// ============================================================================
// ORDERS & TRANSACTIONS
// ============================================================================

model Order {
  id          String @id @default(uuid()) @db.Uuid
  orderNumber String @unique @map("order_number") @db.VarChar(30)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  addressId String      @map("address_id") @db.Uuid
  address   UserAddress @relation(fields: [addressId], references: [id])

  shippingRecipientName  String? @map("shipping_recipient_name") @db.VarChar(100)
  shippingRecipientPhone String? @map("shipping_recipient_phone") @db.VarChar(20)
  shippingStreetAddress  String? @map("shipping_street_address") @db.Text
  shippingWard           String? @map("shipping_ward") @db.VarChar(100)
  shippingDistrict       String? @map("shipping_district") @db.VarChar(100)
  shippingCity           String? @map("shipping_city") @db.VarChar(100)
  shippingAddressNote    String? @map("shipping_address_note") @db.VarChar(500)
  shippingProvinceCode   String? @map("shipping_province_code") @db.VarChar(10)
  shippingProvinceName   String? @map("shipping_province_name") @db.VarChar(100)
  shippingWardCode       String? @map("shipping_ward_code") @db.VarChar(10)
  shippingWardName       String? @map("shipping_ward_name") @db.VarChar(100)

  couponId                    String?       @map("coupon_id") @db.Uuid
  coupon                      Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCodeSnapshot          String?       @map("coupon_code_snapshot") @db.VarChar(50)
  couponDiscountTypeSnapshot  DiscountType? @map("coupon_discount_type_snapshot")
  couponDiscountValueSnapshot Decimal?      @map("coupon_discount_value_snapshot") @db.Decimal(12, 2)
  couponAppliedUnitPrice      Decimal?      @map("coupon_applied_unit_price") @db.Decimal(12, 2)

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  paymentMethod PaymentMethod @map("payment_method")

  subtotal       Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  shippingFee    Decimal @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  totalAmount    Decimal @map("total_amount") @db.Decimal(12, 2)

  items       OrderItem[]
  payment     Payment?
  reviews     Review[]
  couponClaim CouponClaim?
  statusLogs  OrderStatusLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @map("order_id") @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  productName             String  @map("product_name") @db.VarChar(200)
  unitPrice               Decimal @map("unit_price") @db.Decimal(12, 2)
  quantity                Int
  totalPrice              Decimal @map("total_price") @db.Decimal(12, 2)
  selectedOptionsSnapshot Json?   @map("selected_options_snapshot") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusLog {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @map("order_id") @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  previousStatus OrderStatus? @map("previous_status")
  newStatus      OrderStatus  @map("new_status")

  changedById String? @map("changed_by_id") @db.Uuid
  changedBy   User?   @relation(fields: [changedById], references: [id], onDelete: SetNull)

  note      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@map("order_status_logs")
}

model Payment {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @unique @map("order_id") @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  provider           PaymentMethod
  transactionId      String?       @unique @map("transaction_id") @db.VarChar(255)
  amount             Decimal       @db.Decimal(12, 2)
  status             PaymentStatus @default(PENDING)
  rawPayloadResponse Json?         @map("raw_payload_response") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("payments")
}

// ============================================================================
// SOCIAL, REVIEWS & WISHLIST
// ============================================================================

model Review {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  orderId String? @map("order_id") @db.Uuid
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  rating     Int
  comment    String? @db.Text
  images     Json?   @db.JsonB
  isApproved Boolean @default(true) @map("is_approved")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

model WishlistItem {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, productId])
  @@map("wishlist_items")
}

// ============================================================================
// NOTIFICATIONS & AUDITING
// ============================================================================

model Notification {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String           @db.VarChar(200)
  content  String           @db.Text
  type     NotificationType @default(SYSTEM)
  isRead   Boolean          @default(false) @map("is_read")
  readAt   DateTime?        @map("read_at")
  metadata Json?            @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model AuditLog {
  id      String  @id @default(uuid()) @db.Uuid
  actorId String? @map("actor_id") @db.Uuid
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  action         String  @db.VarChar(100)
  resource       String  @db.VarChar(100)
  resourceId     String? @map("resource_id") @db.VarChar(255)
  ipAddress      String? @map("ip_address") @db.VarChar(45)
  userAgent      String? @map("user_agent") @db.Text
  changesPayload Json?   @map("changes_payload") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}
