# Application
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3001
SWAGGER_ENABLED=true

# Local product image uploads. In production, use an HTTPS public URL and a persistent volume or object storage.
UPLOADS_DIRECTORY=uploads
UPLOADS_PUBLIC_BASE_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shopdb?schema=public"

# Authentication
# Use a unique, high-entropy value in every environment.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-at-least-32-characters
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=
